{
  "name": "@omnidotdev/manifold-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "dev": "concurrently --kill-others --names \"GRAPHQL-CODEGEN,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"bun run graphql:generate:watch\" \"vite dev\"",
    "build": "vite build",
    "serve": "vite preview",
    "start": "node .output/server/index.mjs",
    "icons:generate": "bun scripts/generateIcons.ts",
    "graphql:generate": "NODE_PATH=src/ dotenv -e .env.development -- graphql-codegen --config src/lib/graphql/codegen.config.ts",
    "graphql:generate:watch": "bun graphql:generate -w",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check --diagnostic-level=error src",
    "knip": "knip-bun --tags=-knipignore",
    "pwa:audit": "unlighthouse-ci --site https://localhost:3000",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "test:coverage": "bun test src --coverage",
    "test:e2e": "NODE_ENV=test playwright test",
    "test:e2e:ui": "NODE_ENV=test playwright test --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@faker-js/faker": "^10.2.0",
    "@graphql-codegen/add": "^6.0.0",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/import-types-preset": "^3.0.1",
    "@graphql-codegen/plugin-helpers": "^6.1.0",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-graphql-request": "^6.3.0",
    "@graphql-codegen/typescript-msw": "^3.0.1",
    "@graphql-codegen/typescript-operations": "^5.0.7",
    "@graphql-codegen/typescript-react-query": "^7.0.5",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@happy-dom/global-registrator": "^20.0.11",
    "@playwright/test": "^1.57.0",
    "@tanstack/react-devtools": "0.9.0",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@tanstack/react-router-devtools": "1.166.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/bun": "^1.3.5",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@unlighthouse/cli": "^0.17.4",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "knip": "^5.80.0",
    "msw": "^2.12.7",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vite-plugin-mkcert": "^2.0.0"
  },
  "dependencies": {
    "@ark-ui/react": "^5.30.0",
    "@icons-pack/react-simple-icons": "^13.8.0",
    "@omnidotdev/providers": "github:omnidotdev/providers#f8b5bb1874f42caed344d0610bed0d76f96bbfd1",
    "@omnidotdev/thornberry": "github:omnidotdev/thornberry#372ebb2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/nitro-v2-vite-plugin": "^1.141.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "1.167.4",
    "@tanstack/react-router-ssr-query": "^1.167.0",
    "@tanstack/react-start": "1.166.16",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "graphql": "^16.12.0",
    "graphql-request": "^7.4.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hotkeys-hook": "^5.3.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.0.3",
    "zod": "^4.3.5"
  }
}
